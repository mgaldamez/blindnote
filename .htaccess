# =====================================================================
#  Configuracion Apache - BlindNote
# =====================================================================

# Cabeceras de seguridad HTTP (refuerzo de Fase 4)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Activar bajo HTTPS (Fase 2):
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Deshabilitar listado de directorios
Options -Indexes

# No servir archivos sensibles
<FilesMatch "\.(sql|md|log|ini|json)$">
    Require all denied
</FilesMatch>

# Bloquear acceso directo a carpetas internas
RedirectMatch 403 ^/seguridad-web/(config|includes|database)/

# Cabecera de identidad del servidor oculta (opcional)
ServerSignature Off

# BlindNote - variables de entorno (plantilla). Copiar a .env y ajustar.
# .env NO se versiona (.gitignore) ni entra en la imagen (.dockerignore).

# Imagen a ejecutar: latest | main | sha-<commit> | vX.Y.Z
BLINDNOTE_TAG=latest

# Puerto publicado del sitio
WEB_PORT=8080

# Base de datos (DB_HOST=db es el servicio de Compose)
DB_HOST=db
DB_PORT=3306
DB_NOMBRE=seguridad_web
DB_USUARIO=blindnote
DB_CLAVE=blindnote
DB_CHARSET=utf8mb4

# Contraseña de root del contenedor MySQL (solo laboratorio).
# OJO: DB_USUARIO no puede ser "root", la imagen de MySQL lo rechaza.
MYSQL_ROOT_PASSWORD=root

# true = cookie de sesión sólo por HTTPS
COOKIE_SOLO_HTTPS=false
# true = detalles de errores; en producción false
MODO_DEBUG=true

#Maximo intentos fallidos
MAX_INTENTOS_POR_IP=20

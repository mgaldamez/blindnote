# =====================================================================
#  BlindNote - proxy inverso de referencia (nginx)
# ---------------------------------------------------------------------
#  Despliegue asumido:
#    - La app escucha SOLO en loopback: WEB_PORT=127.0.0.1:8080 (.env).
#    - El sitio se sirve UNICAMENTE por 443: no se expone el puerto 80.
#    - La app lee la IP real desde X-Real-IP (ip_cliente()).
#
#  Consecuencia de no abrir el 80: Certbot no puede usar el desafio HTTP-01.
#  Renovar con DNS-01 (certbot certonly --dns-...) o TLS-ALPN-01.
#
#  Aplicar:
#      sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/blindnote
#      sudo ln -s /etc/nginx/sites-available/blindnote /etc/nginx/sites-enabled/
#      sudo nginx -t && sudo systemctl reload nginx
#
#  Verificar:
#      curl -sI https://blindnote.example.com | grep -iE 'strict-transport|server:|http/'
#
#  Requiere nginx >= 1.25.1 por "http2 on;" y >= 1.19.4 por ssl_reject_handshake.
#  En versiones anteriores: "listen 443 ssl http2;" y quitar ssl_reject_handshake.
# =====================================================================

server {
    listen 443 ssl;
    http2 on;
    server_name blindnote.example.com;

    ssl_certificate     /etc/letsencrypt/live/blindnote.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blindnote.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Endurecimiento
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 4m;   # el default (1m) corta notas largas con 413

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # Un solo hop confiable: se sobrescribe en vez de acumular, para que el
        # cliente no pueda inyectar una IP falsa al principio de la lista.
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# Hosts desconocidos: se corta el handshake TLS sin presentar el certificado.
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}
